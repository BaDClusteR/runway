{
    "name": "bad_cluster/runway",
    "type": "library",
    "description": "A Symfony-like platform for building websites and web apps.",
    "keywords": ["runway"],
    "license": "BSD-3-Clause",
    "authors": [
        {"name": "BaD ClusteR", "email": "admin@badcluster.ru"}
    ],
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-yaml": "*",
        "ext-zip": "*",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "infection/infection": "^0.35",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {"Runway\\" : "src/"},
        "files": ["bootstrap.php"]
    },
    "autoload-dev": {
        "psr-4": {"Runway\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:e2e": "phpunit --testsuite e2e",
        "phpstan": "phpstan --memory-limit=1G",
        "infection": "infection --threads=max"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
