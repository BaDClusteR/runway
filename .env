APP_DEBUG=false

; Log levels
;  0 - All logs will be recorded, including debug logs. They can contain request details: use it for debugging only.
;  1 - All logs except debug logs will be recorded.
;  2 - Errors, warnings and deprecation messages will be recorded.
;  3 - Errors and warnings will be recorded.
;  4 - Only errors will be recorded.
;  5 - Only critical errors will be recorded.
;  6 - Only critical errors which require immediate action will be recorded.
LOG_LEVEL=1

; Comma-separated IP addresses of the reverse proxies in front of the server, e.g. a load balancer. Only their
; X-Forwarded-For header is used for the client IP address: anyone else could forge it.
TRUSTED_PROXIES=

MODULES=
